{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "main/**/*.ts",
    "preload/**/*.ts",
    "runtime/**/*.ts",
    "../shared/desktop-contract.js",
    "../shared/desktop-bridge-contract.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "release"
  ]
}
