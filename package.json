{
  "name": "quantora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "node --stack_size=8192 ./node_modules/typescript/bin/tsc --noEmit",
    "test:conversation": "tsx --test api/_lib/conversation-policy.test.ts",
    "test:study-evidence": "tsx --test api/_lib/study-evidence.test.ts",
    "test:study-assessment": "node scripts/run-study-ts-tests.mjs",
    "test:study": "node scripts/run-study-ts-tests.mjs",
    "test:models": "node --test api/_lib/model-catalog.test.js api/_lib/model-canary.test.js api/_lib/model-lifecycle.test.js api/_lib/model-smoke-test.test.js api/_lib/model-store.test.js",
    "test:repository-preview": "tsx --test api/_lib/repository-preview.test.ts",
    "test:quantum": "node --test src/lib/quantum/*.test.js",
    "test:studio-synthetic": "node scripts/studio-synthetic-test.mjs",
    "test:golden:deployed": "node scripts/deployed-golden-transactions.mjs",
    "test:shop-act": "node scripts/shop-preview-act-gate.mjs",
    "test:shop-act:deployed": "node scripts/deployed-shop-preview-gate.mjs",
    "test:preview-shell": "node scripts/preview-shell-must-start-gate.mjs",
    "test:outcome-navigator": "tsx scripts/outcome-navigator-eval.ts",
    "test:ts": "node scripts/run-ts-tests.mjs",
    "test:node": "node scripts/run-node-tests.mjs",
    "test:all": "npm run test:imports && npm run test:hook-order && npm run test:github-writes && npm run test:study-evidence && npm run test:study-assessment && npm run test:ts && npm run test:node && npm run test:studio-synthetic && npm run test:outcome-navigator && npm run test:wiring && npm run test:framed-preview && npm run test:image-parsers && npm run test:served-routes && npm run test:journeys",
    "test:ci": "npm run test:github-writes && npm run test:study-evidence && npm run test:study-assessment && npm run test:ts && npm run test:node && npm run test:studio-synthetic && npm run test:outcome-navigator && npm run test:framed-preview && npm run test:image-parsers && npm run test:served-routes",
    "lint:undef": "eslint 'src/**/*.{js,jsx}'",
    "test:wiring": "node scripts/wiring-gate.mjs",
    "test:stress": "node scripts/stress/pipeline-stress.mjs",
    "verify": "node scripts/verify.mjs",
    "test:claims": "node scripts/capability-claims-gate.mjs",
    "test:dead-controls": "node scripts/platform-dead-control-gate.mjs",
    "test:judgment": "tsx scripts/finance-judgment-gate.mjs",
    "test:github-writes": "node scripts/github-write-seam-gate.mjs",
    "test:imports": "node scripts/runtime-import-gate.mjs",
    "test:hook-order": "node scripts/hook-dependency-order-gate.mjs",
    "test:study-representation-browser": "node scripts/study-representation-browser-gate.mjs",
    "desktop:build": "npm --prefix desktop run build",
    "test:desktop": "xvfb-run -a node scripts/desktop-smoke-gate.mjs",
    "test:served-routes": "node scripts/served-route-gate.mjs",
    "test:journeys": "node scripts/journey-gate-inventory-gate.mjs",
    "audit:lonely": "node scripts/lonely-capability-audit.mjs",
    "test:framed-preview": "node scripts/framed-preview-headers-gate.mjs",
    "test:image-parsers": "node scripts/image-parser-dos-gate.mjs",
    "test:advisories": "node scripts/dependency-advisory-gate.mjs"
  },
  "dependencies": {
    "@duffel/api": "^4.28.0",
    "@google/genai": "^2.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@react-oauth/google": "^0.13.5",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@webcontainer/api": "^1.6.4",
    "archiver": "^8.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "google-auth-library": "^11.0.2",
    "html-docx-js-typescript": "^0.1.5",
    "image-size": "^2.0.2",
    "jimp": "^0.16.13",
    "katex": "^0.18.4",
    "lucide-react": "^0.546.0",
    "monaco-editor": "^0.56.0",
    "p-limit": "^7.3.1",
    "pdfjs-dist": "^6.3.289",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "vite": "^6.2.3",
    "write-excel-file": "^4.1.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "playwright": "1.55.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
