{
  "name": "quantora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:conversation": "tsx --test api/_lib/conversation-policy.test.ts",
    "test:models": "node --test api/_lib/model-catalog.test.js",
    "test:repository-preview": "tsx --test api/_lib/repository-preview.test.ts",
    "test:quantum": "node --test src/lib/quantum/*.test.js",
    "test:studio-synthetic": "node scripts/studio-synthetic-test.mjs",
    "test:office-synthetic": "tsx scripts/office-synthetic-test.ts",
    "test:outcome-navigator": "tsx scripts/outcome-navigator-eval.ts",
    "test:ts": "tsx --test api/_lib/agent-tools.test.ts api/_lib/conversation-engine.test.ts api/_lib/deck-compose.test.ts api/_lib/conversation-policy.test.ts api/_lib/model-payload.test.ts api/_lib/outcome-state.test.ts api/_lib/protected-endpoints.test.ts api/_lib/publish-policy.test.ts api/_lib/repository-preview.test.ts api/_lib/safety-policy.test.ts api/_lib/session-context.test.ts api/_lib/store.test.ts api/_lib/studio-choice-templates.test.ts api/_lib/studio-choices.test.ts api/_lib/studio-domains.test.ts api/_lib/studio-modes.test.ts",
    "test:all": "npm run test:ts && node --test api/_lib/*.test.js src/lib/*.test.js src/lib/quantum/*.test.js && npm run test:office-synthetic && npm run test:studio-synthetic && npm run test:outcome-navigator",
    "lint:undef": "eslint 'src/**/*.{js,jsx}'"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@duffel/api": "^4.28.0",
    "@google/genai": "^2.4.0",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.5",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/openai": "^1.5.6",
    "@react-oauth/google": "^0.13.5",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@webcontainer/api": "^1.6.4",
    "archiver": "^8.0.0",
    "dotenv": "^17.2.3",
    "duckduckgo-search": "^1.0.7",
    "express": "^4.21.2",
    "google-auth-library": "^11.0.2",
    "html-docx-js-typescript": "^0.1.5",
    "image-size": "^2.0.2",
    "jimp": "^0.16.13",
    "langchain": "^1.5.5",
    "lucide-react": "^0.546.0",
    "p-limit": "^7.3.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "vite": "^6.2.3",
    "write-excel-file": "^4.1.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
