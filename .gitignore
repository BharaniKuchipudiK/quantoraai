node_modules
node_modules/
build/
# A bare `build/` matches at every depth, and it silently swallowed
# desktop/build/ — electron-builder's config, the macOS entitlements and the
# app icon. Those are source, not output, and the release workflow checks out
# a tree that has to contain them. The actual packaging output is
# desktop/dist/ (covered by `dist/`) and desktop/release/, ignored explicitly
# below with a rooted path so it cannot repeat the at-any-depth mistake.
!desktop/build/
/desktop/release/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Merge-conflict artefacts. api/chat.ts.orig was committed once and held a
# pre-security copy of the chat endpoint — no session gating, no key
# protection. Harmless while inert, but a genuine trap for anyone reading the
# repo or restoring it by mistake.
*.orig
*.rej

# One-off agent edit/patch scripts must never be committed. Historically ~38
# throwaway `patch_*.cjs` / `test_*.cjs` mutation scripts were committed to the
# repo root and left to rot — clutter that made the tree look broken. Real
# tooling lives in scripts/ and is referenced by package.json.
/patch_*.cjs
/patch_*.js
/test_production.cjs
/test_simulation.cjs
.worktrees/

# Gate output (browser gates, stress runs) — tens of MB, never source.
artifacts/

# Vercel project linkage — local metadata; Vercel says not to commit it.
.vercel/

# Isolated Workflow build and local execution journal.
.nitro/
.output/
.workflow-data/
.swc/
