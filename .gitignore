node_modules
node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Merge-conflict artefacts. api/chat.ts.orig was committed once and held a
# pre-security copy of the chat endpoint — no session gating, no key
# protection. Harmless while inert, but a genuine trap for anyone reading the
# repo or restoring it by mistake.
*.orig
*.rej

# One-off agent edit/patch scripts must never be committed. Historically ~38
# throwaway `patch_*.cjs` / `test_*.cjs` mutation scripts were committed to the
# repo root and left to rot — clutter that made the tree look broken. Real
# tooling lives in scripts/ and is referenced by package.json.
/patch_*.cjs
/patch_*.js
/test_production.cjs
/test_simulation.cjs
.worktrees/

# Browser release gate output. scripts/*-browser-gate.mjs write screenshots here
# and CI uploads the directory as a build artifact — a CI upload path, not
# repository content. Running the gates locally to verify a fix left 5.5 MB of
# PNGs staged, and one `git add -A` swept them into a commit.
artifacts/
