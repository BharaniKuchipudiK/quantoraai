# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Travel providers (server-side only)
# DUFFEL_API_KEY powers live flight search/pricing through Duffel.
# Never expose provider keys through VITE_, NEXT_PUBLIC_, or browser code.
DUFFEL_API_KEY=

# GOOGLE_MAPS_API_KEY powers Google Places API (New) for hotels, attractions,
# restaurants and POIs, and Google Routes API for real route distance/duration.
# Enable both Places API (New) and Routes API on the same Google Cloud project.
# The runtime also accepts GOOGLE_PLACES_API_KEY as a legacy fallback, but
# GOOGLE_MAPS_API_KEY is the canonical variable for new deployments.
GOOGLE_MAPS_API_KEY=

# ADMIN_API_KEY: Required to view the telemetry dashboard at /api/admin/metrics.
# Must be at least 16 characters. Generate one with:  openssl rand -base64 32
# The endpoint fails closed (503) when this is unset — there is no default.
# Never prefix with VITE_ or NEXT_PUBLIC_; it must never reach the browser.
ADMIN_API_KEY=

# SUPABASE_URL / SUPABASE_ANON_KEY: Optional, enables real telemetry logging.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# OPENROUTER_API_KEY: Optional server-side key for non-Gemini models.
OPENROUTER_API_KEY=

# GITHUB_TOKEN: Optional server-side token for private repo import, Create PR,
# and merge (see docs/GITHUB.md). Classic PAT or fine-grained token with
# Contents read + Pull requests read/write. Aliases: GITHUB_PAT, GH_TOKEN.
# Never prefix with VITE_ or NEXT_PUBLIC_.
GITHUB_TOKEN=

# Comma-separated owner/repo allowlist required for Create PR / merge.
# Without this, write APIs fail closed even if GITHUB_TOKEN is set.
GITHUB_ALLOWED_REPOS=

# Protects scheduled catalogue synchronisation through /api/models.
# Set this in Vercel; scheduled requests send it as Authorization: Bearer <value>.
CRON_SECRET=

# SUPABASE_SERVICE_ROLE_KEY: Required for the users and usage tables.
# The anon key above is public by design and is blocked by row-level security
# on those tables; only the service-role key can write them. It bypasses RLS
# entirely, so it must stay server-side — never prefix it with VITE_, and never
# return it in an API response.
# Find it in Supabase: Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=
