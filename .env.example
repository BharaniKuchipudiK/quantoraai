# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_API_KEY: Required to view the telemetry dashboard at /api/admin/metrics.
# Must be at least 16 characters. Generate one with:  openssl rand -base64 32
# The endpoint fails closed (503) when this is unset — there is no default.
# Never prefix with VITE_ or NEXT_PUBLIC_; it must never reach the browser.
ADMIN_API_KEY=

# SUPABASE_URL / SUPABASE_ANON_KEY: Optional, enables real telemetry logging.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# OPENROUTER_API_KEY: Optional server-side key for non-Gemini models.
OPENROUTER_API_KEY=
