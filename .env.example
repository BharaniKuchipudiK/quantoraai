# GEMINI_API_KEY: Optional for non-Travel Gemini features.
# Travel V1 does NOT depend on Gemini/Google for conversation or provider execution.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_API_KEY: Required to view the telemetry dashboard at /api/admin/metrics.
# Must be at least 16 characters. Generate one with: openssl rand -base64 32
# Never prefix with VITE_ or NEXT_PUBLIC_; it must never reach the browser.
ADMIN_API_KEY=

# SUPABASE_URL / SUPABASE_ANON_KEY: Optional, enables real telemetry logging.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# OpenRouter is the server-owned Travel conversation provider.
OPENROUTER_API_KEY=

# Duffel is the primary Travel provider for airport/city resolution, live flights,
# and Duffel Stays once Stays access is enabled for the Duffel organisation.
DUFFEL_API_KEY=

# Amadeus is the independent Travel fallback/provider for flights and hotels,
# and the initial provider for destination activities. Both values are required.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
# test -> https://test.api.amadeus.com (limited/cached data)
# production -> https://api.amadeus.com (live production data)
AMADEUS_ENVIRONMENT=test

# Optional SLA used by scripts/travel-provider-canary.mjs.
TRAVEL_CANARY_MAX_MS=12000

# Protects scheduled catalogue synchronisation through /api/models.
# Set this in Vercel; scheduled requests send it as Authorization: Bearer <value>.
CRON_SECRET=

# SUPABASE_SERVICE_ROLE_KEY: Required for the users and usage tables.
# The anon key above is public by design and is blocked by row-level security
# on those tables; only the service-role key can write them. It bypasses RLS
# entirely, so it must stay server-side — never prefix it with VITE_, and never
# return it in an API response.
SUPABASE_SERVICE_ROLE_KEY=
