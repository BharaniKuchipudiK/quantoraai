{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/generate-office.ts": { "maxDuration": 300 },
    "api/pipeline.ts": { "maxDuration": 180 },
    "api/preview-compile.js": {
      "includeFiles": "node_modules/{react,react-dom,scheduler,lucide-react}/**"
    }
  },
  "crons": [
    {
      "path": "/api/models",
      "schedule": "15 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/preview/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:; img-src 'self' https: data: blob:; connect-src 'self' https:; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self';"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    },
    {
      "source": "/monaco/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/desk",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' blob: https://accounts.google.com https://apis.google.com https://va.vercel-scripts.com https://cdn.jsdelivr.net; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' blob: https://generativelanguage.googleapis.com https://openrouter.ai https://accounts.google.com https://vitals.vercel-insights.com https://*.codesandbox.io https://*.webcontainer-api.io https://*.local-coep.webcontainer-api.io wss://*.webcontainer-api.io; frame-src 'self' blob: https://accounts.google.com https://www.youtube-nocookie.com https://www.youtube.com https://*.codesandbox.io https://*.webcontainer.io https://*.webcontainer-api.io; object-src 'none'; base-uri 'self'; form-action 'self';"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/((?!preview/|desk).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://accounts.google.com https://apis.google.com https://va.vercel-scripts.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://generativelanguage.googleapis.com https://openrouter.ai https://accounts.google.com https://vitals.vercel-insights.com https://*.codesandbox.io; frame-src 'self' blob: https://accounts.google.com https://www.youtube-nocookie.com https://www.youtube.com https://*.codesandbox.io; object-src 'none'; base-uri 'self'; form-action 'self';"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/github/preview",
      "destination": "/api/pipeline?github=preview"
    },
    {
      "source": "/api/github/fetch-repo",
      "destination": "/api/pipeline?github=preview"
    },
    {
      "source": "/api/github/create-pr",
      "destination": "/api/pipeline?github=create-pr"
    },
    {
      "source": "/api/github/merge-pr",
      "destination": "/api/pipeline?github=merge-pr"
    },
    {
      "source": "/api/outcomes",
      "destination": "/api/pipeline"
    },
    {
      "source": "/api/projects",
      "destination": "/api/pipeline"
    },
    {
      "source": "/api/chat",
      "destination": "/api/pipeline?route=chat"
    },
    {
      "source": "/api/trace",
      "destination": "/api/pipeline?route=trace"
    },
    {
      "source": "/api/moderate",
      "destination": "/api/pipeline?route=moderate"
    },
    {
      "source": "/api/product-event",
      "destination": "/api/pipeline?route=product-event"
    },
    {
      "source": "/api/travel-search",
      "destination": "/api/pipeline?route=travel-search"
    },
    {
      "source": "/api/inference-health",
      "destination": "/api/pipeline?route=inference-health"
    },
    {
      "source": "/api/youtube-validate",
      "destination": "/api/pipeline?route=youtube-validate"
    },
    {
      "source": "/api/preview-image",
      "destination": "/api/pipeline?route=preview-image"
    },
    {
      "source": "/api/account",
      "destination": "/api/pipeline?route=account"
    },
    {
      "source": "/api/classify-intent",
      "destination": "/api/pipeline?route=classify-intent"
    },
    {
      "source": "/api/model-route-canary",
      "destination": "/api/pipeline?route=model-route-canary"
    },
    {
      "source": "/api/deploy-status",
      "destination": "/api/deploy-gcp?action=status"
    },
    {
      "source": "/api/auth/verify",
      "destination": "/api/auth?route=verify"
    },
    {
      "source": "/api/auth/session",
      "destination": "/api/auth?route=session"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth?route=logout"
    },
    {
      "source": "/api/auth/signup",
      "destination": "/api/auth?route=signup"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/auth?route=login"
    },
    {
      "source": "/api/auth/password-reset-request",
      "destination": "/api/auth?route=password-reset-request"
    },
    {
      "source": "/api/auth/password-reset-confirm",
      "destination": "/api/auth?route=password-reset-confirm"
    },
    {
      "source": "/api/auth/github",
      "destination": "/api/auth?route=github"
    },
    {
      "source": "/api/auth/github/callback",
      "destination": "/api/auth?route=github-callback"
    },
    {
      "source": "/api/admin/feedback",
      "destination": "/api/admin?route=feedback"
    },
    {
      "source": "/api/admin/metrics",
      "destination": "/api/admin?route=metrics"
    },
    {
      "source": "/api/admin/models",
      "destination": "/api/admin?route=models"
    },
    {
      "source": "/((?!api/.*|preview/.*|monaco/.*).*)",
      "destination": "/index.html"
    }
  ]
}
